CH_CONSOLE_LISTEN=:8080
CH_CONSOLE_DATA_DIR=./data
CH_CONSOLE_BASE_PATH=
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_ALIAS=default
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default
CH_CONSOLE_QUERY_TIMEOUT=60s
CH_CONSOLE_MAX_ROWS=1000
# Multi-cluster mode (when set, this replaces the CLICKHOUSE_* values above):
# CH_CONSOLE_CLUSTERS=[{"alias":"primary","url":"http://clickhouse-1:8123","user":"default","password":"","database":"default"},{"alias":"analytics","url":"http://clickhouse-2:8123","user":"default","password":"","database":"default"}]
# Optional only for the very first startup:
# CH_CONSOLE_ADMIN_USER=admin
# CH_CONSOLE_ADMIN_PASSWORD=replace-with-a-long-random-password
